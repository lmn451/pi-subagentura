{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    "*.tsbuildinfo",
    "coverage/",
    ".vitest-cache/",
    "*.log",
    "npm-debug.log*",
    ".vscode/",
    ".idea/",
    "*.swp",
    ".DS_Store",
    "*.tgz"
  ]
}
