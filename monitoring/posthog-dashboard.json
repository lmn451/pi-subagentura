    {
      "key": "session-journey",
      "name": "Session journey: start → launch → successful work",
      "description": "Ordered steps within 24 hours. Anonymous session/tree adoption context, not stable users or exact job conversion. Parallel jobs can satisfy different steps; event loss and ingestion order affect progression.",
      "id": 11619646,
      "short_id": "Ao4ENbDf",
      "query": {
        "kind": "InsightVizNode",
        "source": {
          "kind": "FunnelsQuery",
          "dateRange": {
            "date_from": "-7d"
          },
          "funnelsFilter": {
            "funnelOrderType": "ordered",
            "funnelWindowInterval": 24,
            "funnelWindowIntervalUnit": "hour",
            "funnelVizType": "steps"
          },
          "series": [
            {
              "kind": "EventsNode",
              "event": "pi_subagentura_session_started",
              "custom_name": "Session tree started"
            },
            {
              "kind": "EventsNode",
              "event": "pi_subagentura_agent_created",
              "custom_name": "Agent created"
            },
            {
              "kind": "EventsNode",
              "event": "pi_subagentura_task_completed",
              "custom_name": "Successful work observed",
              "properties": [
                {
                  "key": "status",
                  "type": "event",
                  "operator": "exact",
                  "value": ["success"]
                }
              ]
            }
          ]
        }
      }
    },
