{
  "name": "pi-subagentura",
  "version": "2.3.0",
  "description": "Public Pi package that adds in-process sub-agents via the SDK",
  "author": "lmn451",
  "license": "MIT",
  "main": "src/subagent.ts",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "subagent",
    "agent",
    "multi-agent",
    "swarm",
    "crew"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lmn451/pi-subagentura"
  },
  "homepage": "https://github.com/lmn451/pi-subagentura#readme",
  "bugs": {
    "url": "https://github.com/lmn451/pi-subagentura/issues"
  },
  "files": [
    "LICENSE",
    "src/ndjson.d.ts",
    "src/notifications.ts",
    "src/rendering.ts",
    "src/schemas.ts",
    "src/artifact.ts",
    "src/artifact-poller.ts",
    "src/helpers.ts",
    "src/tools/in-process.ts",
    "src/tools/interactive.ts",
    "src/interactive-tmux.ts",
    "src/multiplexer.ts",
    "src/multiplexer-tmux.ts",
    "src/multiplexer-zellij.ts",
    "src/rehydrate.ts",
    "src/session-handlers.ts",
    "src/subagent.ts",
    "src/subagent-artifact-cli.ts",
    "src/workflow.ts"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./src/subagent.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "npm pack --dry-run"
  },
  "simple-git-hooks": {
    "pre-push": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css,html}": "prettier --check"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "is-path-inside": "^4.0.0",
    "ndjson": "^2.0.0"
  }
}
